<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Family;
use Fisharebest\Webtrees\Http\Controllers\AddChildToFamily;
use Fisharebest\Webtrees\Http\Controllers\ReorderChildren;
use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Individual;

/**
 * @var Family $family
 */

// The children, and children without a record, e.g. "1 CHIL @VOID@" + "2 PHRASE Second child"
$children = [];

foreach ($family->facts(['CHIL']) as $fact) {
    if ($fact->target() instanceof Individual && $family->children()->contains($fact->target())) {
        $children[] = $fact->target();
    } elseif ($fact->value() === '@VOID@') {
        $children[] = $fact->attribute('PHRASE');
    }
}

?>

<div class="align-self-center">
    <div class="badge bg-secondary m-2">
        <?php if ($children === []) : ?>
            <?= I18N::translate('No children') ?>
        <?php else : ?>
            <?= I18N::plural('%s child', '%s children', count($children), I18N::number(count($children))) ?>
        <?php endif ?>
    </div>
    <?php foreach ($children as $n => $child) : ?>
        <div class="d-flex">
            <?php if ($child instanceof Individual) : ?>
                <?= view('chart-box', ['individual' => $child]) ?>
            <?php else : ?>
                <div class="wt-chart-box">
                    <?php if ($child !== '') : ?>
                        <div class="wt-chart-box-name"><?= e($child) ?></div>
                    <?php endif ?>
                    <div class="small text-muted"><?= I18N::translate('Not recorded') ?></div>
                </div>
            <?php endif ?>
            <div class="wt-chart-horizontal-spacer">
                <?php if (count($children) === 1) : ?>
                    <div class="wt-chart-horizontal-line"></div>
                <?php elseif ($n === 0) : ?>
                    <div class="wt-chart-horizontal-first-child"></div>
                <?php elseif ($n + 1 === count($children)) : ?>
                    <div class="wt-chart-horizontal-last-child"></div>
                <?php else : ?>
                    <div class="wt-chart-horizontal-middle-child"><div class="wt-chart-horizontal-line"></div></div>
                <?php endif ?>
            </div>
        </div>
    <?php endforeach ?>
    <?php if ($family->canEdit()) : ?>
        <div class="wt-chart-box">
            <a class="btn btn-link" href="<?= e(route(AddChildToFamily::class, ['tree' => $family->tree()->name(), 'xref' => $family->xref(), 'sex' => 'M'])) ?>">
                <?= I18N::translate('Add a son') ?>
            </a>
            |
            <a class="btn btn-link" href="<?= e(route(AddChildToFamily::class, ['tree' => $family->tree()->name(), 'xref' => $family->xref(), 'sex' => 'F'])) ?>">
                <?= I18N::translate('Add a daughter') ?>
            </a>
            <br>
            <?php if ($family->numberOfChildren() > 1) : ?>
                <a class="btn btn-link" href="<?= e(route(ReorderChildren::class, ['tree' => $family->tree()->name(), 'xref' => $family->xref()])) ?>">
                    <?= I18N::translate('Re-order children') ?>
                </a>
            <?php endif ?>
        </div>
    <?php endif ?>
</div>
<?php if (count($children) !== 1) : ?>
    <div class="wt-chart-horizontal-spacer">
        <div class="wt-chart-horizontal-line"></div>
    </div>
<?php endif ?>
