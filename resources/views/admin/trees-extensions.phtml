<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Http\Controllers\ControlPanel;
use Fisharebest\Webtrees\Http\Controllers\ManageTrees;
use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Tree;

/**
 * @var array<string,array{count:int,path:string,label:string,uri:string}> $tags
 * @var string                                                             $title
 * @var Tree                                                               $tree
 */

?>

<?= view('components/breadcrumbs', ['links' => [route(ControlPanel::class) => I18N::translate('Control panel'), route(ManageTrees::class, ['tree' => $tree->name()]) => I18N::translate('Manage family trees'), $title]]) ?>

<h1><?= $title ?></h1>

<p>
    <?= I18N::translate('GEDCOM 7.0 documents extension tags with a URI in the header of a file (HEAD:SCHMA).  Tags that webtrees knows have a label.') ?>
</p>

<?php if ($tags === []) : ?>
    <p><?= I18N::translate('This family tree has no extension tags.') ?></p>
<?php else : ?>
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th><?= I18N::translate('GEDCOM tag') ?></th>
                <th><?= I18N::translate('Label') ?></th>
                <th class="text-end"><?= I18N::translate('Count') ?></th>
                <th><?= I18N::translate('Example') ?></th>
                <th><?= I18N::translate('URI') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($tags as $tag => $data) : ?>
                <tr>
                    <td><code><?= e($tag) ?></code></td>
                    <td><?= $data['label'] === '' ? '<span class="text-muted">' . I18N::translate('unknown') . '</span>' : $data['label'] ?></td>
                    <td class="text-end"><?= I18N::number($data['count']) ?></td>
                    <td><code><?= e($data['path']) ?></code></td>
                    <td><?= $data['uri'] === '' ? '' : '<a href="' . e($data['uri']) . '" rel="noreferrer">' . e($data['uri']) . '</a>' ?></td>
                </tr>
            <?php endforeach ?>
        </tbody>
    </table>
<?php endif ?>
